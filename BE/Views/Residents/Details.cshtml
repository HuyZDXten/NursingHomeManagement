@model Resident
@{
    ViewData["Title"] = Model.FullName;
    bool isActive = Model.Status == ResidentStatus.Active;
    string initial = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName[..1].ToUpperInvariant() : "R";
    var contacts = (List<FamilyContact>)ViewData["Contacts"]!;
    var links = (List<ResidentFamilyLink>)ViewData["Links"]!;
}
<div class="page-heading">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="resident-avatar gold" style="width:60px;height:60px;font-size:1.5rem;">@initial</span>
        <div>
            <p class="eyebrow mb-1"><i class="bi bi-person-badge"></i> HỒ SƠ CƯ DÂN · @Model.Code</p>
            <h1 class="mb-1">@Model.FullName</h1>
            <div class="d-flex align-items-center gap-2 flex-wrap text-secondary small">
                <span class="status-badge @(isActive ? "status-active" : "status-discharged")">@Model.Status</span>
                <span>· Nhập viện @Model.AdmittedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách cư dân
        </a>
    </div>
</div>

<div class="card p-4 mb-4">
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <span class="text-secondary small d-block">Ngày sinh</span>
                <strong class="fs-6">@Model.DateOfBirth.ToString("dd/MM/yyyy")</strong>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <span class="text-secondary small d-block">Giới tính</span>
                <strong class="fs-6">@(string.IsNullOrWhiteSpace(Model.Gender) ? "—" : Model.Gender)</strong>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <span class="text-secondary small d-block">Ngày ngừng lưu trú</span>
                <strong class="fs-6">@(Model.DischargedAt?.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy") ?? "Đang lưu trú")</strong>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="p-3 rounded-3 bg-light border h-100">
                <span class="text-secondary small d-block">Ghi chú chuyên môn</span>
                <strong class="fs-6">@(string.IsNullOrWhiteSpace(Model.Notes) ? "Không có ghi chú" : Model.Notes)</strong>
            </div>
        </div>
    </div>
</div>

<div class="card p-3 mb-4">
    <div class="row-actions">
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Caregiver))
        {
            <a asp-controller="Health" asp-action="Index" asp-route-residentId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-heart-pulse me-1"></i> Sinh hiệu
            </a>
            <a asp-controller="Medication" asp-action="Index" asp-route-residentId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-capsule me-1"></i> Lịch thuốc
            </a>
        }
        @if (!User.IsInRole(Roles.Caregiver))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i> Sửa hồ sơ
            </a>
            <a asp-controller="Beds" asp-action="Assign" asp-route-residentId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-door-open me-1"></i> Phân / chuyển giường
            </a>
            <a asp-controller="Beds" asp-action="History" asp-route-residentId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-clock-history me-1"></i> Lịch sử giường
            </a>
            <a asp-controller="Billing" asp-action="Subscribe" asp-route-residentId="@Model.Id" class="btn btn-outline-primary">
                <i class="bi bi-gem me-1"></i> Đăng ký gói
            </a>
            @if (Model.Status == ResidentStatus.Active)
            {
                <form asp-action="Discharge" asp-route-id="@Model.Id" method="post" data-confirm="Ngừng lưu trú, trả giường và dừng công việc/lịch thuốc?" class="ms-lg-auto">
                    <button class="btn btn-outline-danger" type="submit">
                        <i class="bi bi-box-arrow-right me-1"></i> Ngừng lưu trú
                    </button>
                </form>
            }
        }
    </div>
</div>

@if (!User.IsInRole(Roles.Caregiver))
{
    <div class="row g-4">
        <div class="col-lg-6">
            <section class="card p-4 h-100">
                <div class="section-heading mb-3">
                    <div>
                        <p class="eyebrow mb-1"><i class="bi bi-telephone-forward"></i> DANH BẠ GIA ĐÌNH</p>
                        <h2 class="h5 fw-bold mb-0">Người liên hệ</h2>
                    </div>
                    <a asp-action="Contact" asp-route-residentId="@Model.Id" class="btn btn-sm btn-primary">+ Thêm liên hệ</a>
                </div>
                @foreach (var contact in contacts)
                {
                    <div class="border rounded-3 p-3 mb-2 d-flex justify-content-between align-items-start gap-3 bg-light">
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <strong>@contact.FullName</strong>
                                <span class="badge text-bg-secondary">@contact.Relationship</span>
                                @if (contact.IsEmergencyContact)
                                {
                                    <span class="status-badge status-cancelled">Khẩn cấp</span>
                                }
                            </div>
                            <div class="small text-secondary mt-1">
                                <i class="bi bi-telephone me-1"></i>@contact.Phone · <i class="bi bi-envelope ms-2 me-1"></i>@contact.Email
                            </div>
                        </div>
                        <a asp-action="Contact" asp-route-residentId="@Model.Id" asp-route-id="@contact.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                    </div>
                }
                @if (!contacts.Any())
                {
                    <p class="text-secondary mb-0">Chưa có người liên hệ nào được lưu.</p>
                }
            </section>
        </div>
        <div class="col-lg-6">
            <section class="card p-4 h-100">
                <div class="section-heading mb-3">
                    <div>
                        <p class="eyebrow mb-1"><i class="bi bi-shield-lock"></i> CỔNG THÔNG TIN FAMILY</p>
                        <h2 class="h5 fw-bold mb-0">Tài khoản Family & quyền chia sẻ</h2>
                    </div>
                    <a asp-action="Link" asp-route-residentId="@Model.Id" class="btn btn-sm btn-primary">Liên kết / cập nhật quyền</a>
                </div>
                @foreach (var link in links)
                {
                    <div class="border rounded-3 p-3 mb-2 bg-light">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            <strong><i class="bi bi-person-check-fill text-primary me-1"></i>@link.FamilyUser.Email</strong>
                            <div class="row-actions">
                                <a asp-action="Link" asp-route-residentId="@Model.Id" asp-route-familyUserId="@link.FamilyUserId" class="btn btn-sm btn-outline-primary">Sửa quyền</a>
                                <form asp-action="Unlink" asp-route-id="@link.Id" method="post" data-confirm="Thu hồi quyền truy cập của người thân này?">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Hủy liên kết</button>
                                </form>
                            </div>
                        </div>
                        <p class="small text-secondary mb-0">
                            Sức khỏe: <strong>@(link.CanViewHealth ? "Có" : "Không")</strong> ·
                            Chăm sóc: <strong>@(link.CanViewCare ? "Có" : "Không")</strong> ·
                            Thuốc: <strong>@(link.CanViewMedication ? "Có" : "Không")</strong> ·
                            Hóa đơn: <strong>@(link.CanViewBilling ? "Có" : "Không")</strong>
                        </p>
                    </div>
                }
                @if (!links.Any())
                {
                    <p class="text-secondary mb-0">Chưa có tài khoản Family nào được liên kết.</p>
                }
            </section>
        </div>
    </div>
}
