@model PagedList<Resident>
@{
    ViewData["Title"] = "Hồ sơ cư dân";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-person-vcard-fill"></i> NURSING HOME · QUẢN LÝ LƯU TRÚ</p>
        <h1>Hồ sơ cư dân</h1>
        <p class="text-secondary mb-0">Tra cứu thông tin lưu trú, lịch sử phòng giường, sức khỏe và liên kết tài khoản gia đình.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i> + Tiếp nhận cư dân
            </a>
        }
    </div>
</div>
<form method="get" class="filter-bar">
    <input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tìm theo mã hoặc họ tên cư dân…" aria-label="Tìm kiếm" />
    <select name="status" class="form-select" aria-label="Trạng thái">
        <option value="">Tất cả trạng thái</option>
        @foreach (var status in Enum.GetValues<ResidentStatus>())
        {
            <option value="@status" selected="@(Context.Request.Query["status"] == status.ToString())">@status</option>
        }
    </select>
    @foreach (var key in new[] { "residentId", "id" })
    {
        if (Context.Request.Query.ContainsKey(key))
        {
            <input type="hidden" name="@key" value="@Context.Request.Query[key]" />
        }
    }
    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc hồ sơ</button>
</form>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Họ và tên</th>
                    <th>Ngày sinh</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    bool isActive = item.Status == ResidentStatus.Active;
                    string initial = !string.IsNullOrWhiteSpace(item.FullName) ? item.FullName[..1].ToUpperInvariant() : "R";
                    <tr>
                        <td><span class="badge text-bg-light border fw-semibold">@item.Code</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="resident-avatar">@initial</span>
                                <div>
                                    <div class="fw-bold">@item.FullName</div>
                                    <div class="small text-secondary">Giới tính: @(string.IsNullOrWhiteSpace(item.Gender) ? "—" : item.Gender)</div>
                                </div>
                            </div>
                        </td>
                        <td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(isActive ? "status-active" : "status-discharged")">
                                <i class="bi @(isActive ? "bi-check-circle-fill" : "bi-dash-circle")"></i> @item.Status
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a asp-controller="Residents" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-folder2-open me-1"></i> Hồ sơ
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
