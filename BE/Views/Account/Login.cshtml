@model NursingHomeManagement.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="login-wrapper">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-7">
            <div class="login-showcase">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="topbar-badge" style="background: rgba(229,193,101,0.16); color: var(--gold-light); border-color: rgba(229,193,101,0.35);">
                            <i class="bi bi-stars"></i> AN TÂM LUXURY NURSING HOME
                        </span>
                    </div>
                    <h2 class="h2 fw-bold text-white mb-3">Hệ sinh thái Quản lý & Chăm sóc Dưỡng lão Chuẩn 5 Sao</h2>
                    <p class="text-light opacity-75 mb-4">
                        Không gian kết nối đồng bộ giữa Ban Quản Trị, Lễ Tân, Đội ngũ Điều dưỡng và Gia đình cư dân —
                        đảm bảo từng chỉ số sức khỏe, lịch dùng thuốc và chi phí lưu trú luôn minh bạch, chính xác.
                    </p>
                    <div class="mb-4">
                        <small class="text-uppercase fw-bold d-block mb-2" style="color: var(--gold-light); letter-spacing: 0.1em; font-size: 0.72rem;">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Chọn nhanh tài khoản Demo theo vai trò (Nhấn để điền Email)
                        </small>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <button type="button" class="role-quick-btn" onclick="document.getElementById('Email').value='admin@demo.nursinghome.test'; document.getElementById('Password').focus();">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-award-fill text-warning fs-5"></i>
                                        <div>
                                            <strong class="d-block small">Quản trị viên (Admin)</strong>
                                            <span class="text-light opacity-75" style="font-size: 0.75rem;">admin@demo.nursinghome.test</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-sm-6">
                                <button type="button" class="role-quick-btn" onclick="document.getElementById('Email').value='receptionist@demo.nursinghome.test'; document.getElementById('Password').focus();">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-check-fill text-info fs-5"></i>
                                        <div>
                                            <strong class="d-block small">Lễ tân (Receptionist)</strong>
                                            <span class="text-light opacity-75" style="font-size: 0.75rem;">receptionist@demo.nursinghome.test</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-sm-6">
                                <button type="button" class="role-quick-btn" onclick="document.getElementById('Email').value='caregiver@demo.nursinghome.test'; document.getElementById('Password').focus();">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-heart-pulse-fill text-danger fs-5"></i>
                                        <div>
                                            <strong class="d-block small">Điều dưỡng (Caregiver)</strong>
                                            <span class="text-light opacity-75" style="font-size: 0.75rem;">caregiver@demo.nursinghome.test</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                            <div class="col-sm-6">
                                <button type="button" class="role-quick-btn" onclick="document.getElementById('Email').value='family@demo.nursinghome.test'; document.getElementById('Password').focus();">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-house-heart-fill text-success fs-5"></i>
                                        <div>
                                            <strong class="d-block small">Gia đình (Family / Người dùng)</strong>
                                            <span class="text-light opacity-75" style="font-size: 0.75rem;">family@demo.nursinghome.test</span>
                                        </div>
                                    </div>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-light opacity-75">Bạn là khách tham quan hoặc người nhà muốn tìm hiểu dịch vụ?</span>
                    <a asp-controller="Home" asp-action="Welcome" class="btn btn-gold btn-sm">
                        <i class="bi bi-globe2 me-1"></i> Xem Trang chủ người dùng
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-5 d-flex align-items-center justify-content-center">
            <div class="login-card card p-1">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="topbar-badge"><i class="bi bi-shield-lock-fill"></i> CỔNG ĐĂNG NHẬP</span>
                        <a asp-controller="Home" asp-action="Welcome" class="small text-decoration-none fw-semibold">
                            <i class="bi bi-house-heart me-1"></i> Trang chủ
                        </a>
                    </div>
                    <h1 class="h3 fw-bold mb-1">Chào mừng trở lại</h1>
                    <p class="text-secondary small mb-4">Đăng nhập bằng tài khoản được quản trị viên cấp để vào không gian vai trò của bạn.</p>
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert">
                        </div>
                        <input asp-for="ReturnUrl" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email tài khoản</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control border-start-0" placeholder="name@demo.nursinghome.test" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-secondary"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0" placeholder="••••••••••••" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small">Ghi nhớ phiên đăng nhập trên thiết bị này</label>
                        </div>
                        <button class="btn btn-primary w-100 py-2" type="submit">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập vào hệ thống
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
