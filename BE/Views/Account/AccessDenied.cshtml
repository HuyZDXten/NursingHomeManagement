@{
    ViewData["Title"] = "Không có quyền truy cập";
}
<div class="card p-5 text-center mx-auto" style="max-width: 640px;">
    <div class="mb-3">
        <span class="metric-icon crimson mx-auto" style="width:64px;height:64px;font-size:1.8rem;">
            <i class="bi bi-shield-exclamation"></i>
        </span>
    </div>
    <p class="eyebrow justify-content-center">TRUY CẬP BỊ TỪ CHỐI · 403 FORBIDDEN</p>
    <h1 class="h3 fw-bold mb-2">Bạn không có quyền truy cập trang này.</h1>
    <p class="text-secondary mb-4">
        Tài khoản hiện tại không thuộc nhóm vai trò được phép thực hiện thao tác này. Liên hệ quản trị viên nếu cần điều chỉnh quyền.
    </p>
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        @if (User.IsInRole(Roles.Family))
        {
            <a asp-controller="Family" asp-action="Index" class="btn btn-primary">Về Trang chủ Gia đình</a>
        }
        else if (User.IsInRole(Roles.Caregiver))
        {
            <a asp-controller="Caregiver" asp-action="Index" class="btn btn-primary">Về Không gian Ca trực</a>
        }
        else if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
        {
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Về Tổng quan Hệ thống</a>
        }
        <a asp-controller="Home" asp-action="Welcome" class="btn btn-outline-secondary">Trang chủ Viện dưỡng lão</a>
    </div>
</div>
