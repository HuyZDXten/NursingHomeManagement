@model PagedList<BedAssignment>
@{
    ViewData["Title"] = "Lịch sử phân giường";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-clock-history"></i> NURSING HOME · ĐIỀU PHỐI LƯU TRÚ</p>
        <h1>Lịch sử phân giường</h1>
        <p class="text-secondary mb-0">Theo dõi toàn bộ quá trình nhận giường, chuyển giường và trả giường của cư dân.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Assign" class="btn btn-primary"><i class="bi bi-arrow-left-right me-1"></i> Phân / chuyển giường</a>
    </div>
</div>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Cư dân</th>
                    <th>Phòng / giường</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Resident.FullName</td>
                        <td><span class="badge text-bg-light border">Phòng @item.Bed.Room.Number / Giường @item.Bed.Number</span></td>
                        <td>@item.StartedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.EndedAt is null)
                            {
                                <span class="status-badge status-occupied">Đang sử dụng</span>
                            }
                            else
                            {
                                <span>@item.EndedAt.Value.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (item.EndedAt is null)
                                {
                                    <form asp-controller="Beds" asp-action="Release" asp-route-residentId="@item.ResidentId" method="post" data-confirm="Xác nhận trả giường?">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Trả giường</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
