@model List<Resident>
@{
    ViewData["Title"] = "Trang chủ Gia đình & Người thân";
    int activeCount = Model.Count(item => item.Status == ResidentStatus.Active);
}

<section class="hero-luxury">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="eyebrow"><i class="bi bi-house-heart-fill"></i> CỔNG THÔNG TIN GIA ĐÌNH · FAMILY PORTAL</span>
            <h1 class="mt-3 mb-2">Người thân của bạn tại An Tâm Residence</h1>
            <p class="text-light opacity-75 mb-4">
                Chào mừng quý gia đình. Tại đây bạn có thể theo dõi tình trạng lưu trú, chỉ số sinh hiệu, nhật ký chăm sóc,
                lịch dùng thuốc và hóa đơn dịch vụ của người thân một cách minh bạch, an toàn.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Home" asp-action="Welcome" class="btn btn-gold">
                    <i class="bi bi-gem me-1"></i> Xem các gói dịch vụ & tiện ích
                </a>
                <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-light">
                    <i class="bi bi-shield-lock me-1"></i> Bảo mật tài khoản
                </a>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="row g-3">
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small>Hồ sơ liên kết</small>
                        <strong>@Model.Count</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small>Đang lưu trú</small>
                        <strong>@activeCount</strong>
                    </div>
                </div>
                <div class="col-12">
                    <div class="hero-stat-pill">
                        <small><i class="bi bi-telephone-inbound-fill me-1"></i> Đường dây hỗ trợ Gia đình 24/7</small>
                        <strong class="fs-6">1900 6868 · Lễ tân & Trực Y tế</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.Any())
{
    <div class="row g-4 mb-4">
        @foreach (var item in Model)
        {
            string initial = !string.IsNullOrWhiteSpace(item.FullName) ? item.FullName[..1].ToUpperInvariant() : "R";
            bool isActive = item.Status == ResidentStatus.Active;
            <div class="col-md-6">
                <div class="card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <span class="resident-avatar gold" style="width:52px;height:52px;font-size:1.25rem;">@initial</span>
                            <div>
                                <span class="text-secondary small fw-semibold">Mã hồ sơ: @item.Code</span>
                                <h2 class="h4 fw-bold mb-0">@item.FullName</h2>
                            </div>
                        </div>
                        <span class="status-badge @(isActive ? "status-active" : "status-discharged")">
                            <i class="bi @(isActive ? "bi-heart-pulse-fill" : "bi-archive")"></i>
                            @(isActive ? "Đang lưu trú" : "Ngừng lưu trú")
                        </span>
                    </div>
                    <div class="row g-2 small text-secondary bg-light p-3 rounded-3 border mb-3">
                        <div class="col-6">
                            <span class="d-block text-muted">Ngày sinh</span>
                            <strong class="text-dark">@item.DateOfBirth.ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <span class="d-block text-muted">Giới tính</span>
                            <strong class="text-dark">@(string.IsNullOrWhiteSpace(item.Gender) ? "—" : item.Gender)</strong>
                        </div>
                        <div class="col-6">
                            <span class="d-block text-muted">Ngày tiếp nhận</span>
                            <strong class="text-dark">@item.AdmittedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy")</strong>
                        </div>
                        <div class="col-6">
                            <span class="d-block text-muted">Trạng thái hồ sơ</span>
                            <strong class="text-dark">@item.Status</strong>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                        <span class="small text-secondary"><i class="bi bi-shield-check text-success me-1"></i> Đã xác thực liên kết gia đình</span>
                        <a asp-controller="Family" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-journal-medical me-1"></i> Xem chi tiết sức khỏe & chăm sóc
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card table-card mb-4">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <p class="eyebrow mb-1">DANH SÁCH TỔNG HỢP</p>
            <h2 class="h5 fw-bold mb-0">Hồ sơ người thân được liên kết</h2>
        </div>
        <span class="text-secondary small">Chỉ hiển thị cư dân đã được Ban quản lý xác thực liên kết với tài khoản của bạn</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    bool isActive = item.Status == ResidentStatus.Active;
                    <tr>
                        <td><span class="badge text-bg-light border">@item.Code</span></td>
                        <td class="fw-semibold">@item.FullName</td>
                        <td>@item.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="status-badge @(isActive ? "status-active" : "status-discharged")">@item.Status</span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a asp-controller="Family" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Xem thông tin
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
