@model FamilyDetailsViewModel
@{
    ViewData["Title"] = Model.Resident.FullName;
    bool isActive = Model.Resident.Status == ResidentStatus.Active;
}

<div class="page-heading">
    <div class="d-flex align-items-center gap-3 flex-wrap">
        <span class="resident-avatar gold" style="width:58px;height:58px;font-size:1.4rem;">
            @(string.IsNullOrWhiteSpace(Model.Resident.FullName) ? "R" : Model.Resident.FullName[..1].ToUpperInvariant())
        </span>
        <div>
            <p class="eyebrow mb-1"><i class="bi bi-house-heart"></i> THÔNG TIN NGƯỜI THÂN · @Model.Resident.Code</p>
            <h1 class="mb-1">@Model.Resident.FullName</h1>
            <div class="d-flex align-items-center gap-2 flex-wrap text-secondary small">
                <span class="status-badge @(isActive ? "status-active" : "status-discharged")">@Model.Resident.Status</span>
                <span>· Ngày sinh @Model.Resident.DateOfBirth.ToString("dd/MM/yyyy")</span>
                <span>· Nhập viện @Model.Resident.AdmittedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Family" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Danh sách người thân
        </a>
    </div>
</div>

<div class="card p-3 mb-4 bg-light border">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="small text-secondary">
            <i class="bi bi-shield-check text-primary me-1"></i>
            Chỉ hiển thị thông tin được cơ sở cho phép chia sẻ. Mỗi phần hiển thị tối đa 10 bản ghi mỗi trang.
        </span>
        <div class="d-flex gap-2 flex-wrap">
            <span class="status-badge @(Model.Permissions.CanViewHealth ? "status-active" : "status-discharged")">
                <i class="bi bi-heart-pulse"></i> Sức khỏe: @(Model.Permissions.CanViewHealth ? "Được xem" : "Tắt")
            </span>
            <span class="status-badge @(Model.Permissions.CanViewCare ? "status-active" : "status-discharged")">
                <i class="bi bi-clipboard2-check"></i> Chăm sóc: @(Model.Permissions.CanViewCare ? "Được xem" : "Tắt")
            </span>
            <span class="status-badge @(Model.Permissions.CanViewMedication ? "status-active" : "status-discharged")">
                <i class="bi bi-capsule"></i> Thuốc: @(Model.Permissions.CanViewMedication ? "Được xem" : "Tắt")
            </span>
            <span class="status-badge @(Model.Permissions.CanViewBilling ? "status-active" : "status-discharged")">
                <i class="bi bi-receipt"></i> Hóa đơn: @(Model.Permissions.CanViewBilling ? "Được xem" : "Tắt")
            </span>
        </div>
    </div>
</div>

@if (Model.Permissions.CanViewHealth)
{
    <section class="card p-4 mb-4">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1"><i class="bi bi-heart-pulse-fill"></i> CHỈ SỐ SINH HIỆU</p>
                <h2 class="h5 fw-bold mb-0">Sức khỏe được chia sẻ</h2>
            </div>
        </div>
        @foreach (var item in Model.Health)
        {
            <div class="border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                    <strong class="text-primary">
                        <i class="bi bi-clock me-1"></i>@item.RecordedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm")
                    </strong>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge text-bg-light border">Huyết áp @item.Systolic/@item.Diastolic mmHg</span>
                        <span class="badge text-bg-light border">Nhịp tim @item.HeartRate bpm</span>
                        <span class="badge text-bg-light border">Nhiệt độ @item.Temperature °C</span>
                        <span class="badge text-bg-light border">SpO2 @(item.SpO2?.ToString() ?? "—")%</span>
                    </div>
                </div>
                <p class="mb-0 text-secondary">@item.Notes</p>
            </div>
        }
        @if (!Model.Health.Any())
        {
            <p class="text-secondary mb-0">Chưa có bản ghi sinh hiệu nào được chia sẻ.</p>
        }
    </section>
}

@if (Model.Permissions.CanViewCare)
{
    <section class="card p-4 mb-4">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1"><i class="bi bi-clipboard2-pulse-fill"></i> NHẬT KÝ ĐIỀU DƯỠNG</p>
                <h2 class="h5 fw-bold mb-0">Chăm sóc được chia sẻ</h2>
            </div>
        </div>
        @foreach (var item in Model.Care)
        {
            <div class="border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                    <strong>@item.PerformedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm") · @item.CareTask.Title</strong>
                    <span class="status-badge status-completed">@item.Status</span>
                </div>
                <p class="mb-0 text-secondary">@item.Result</p>
            </div>
        }
        @if (!Model.Care.Any())
        {
            <p class="text-secondary mb-0">Chưa có nhật ký chăm sóc nào được chia sẻ.</p>
        }
    </section>
}

@if (Model.Permissions.CanViewMedication)
{
    <section class="card p-4 mb-4">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1"><i class="bi bi-capsule-pill"></i> PHÁC ĐỒ ĐÃ PHÊ DUYỆT</p>
                <h2 class="h5 fw-bold mb-0">Lịch thuốc (chỉ đọc)</h2>
            </div>
        </div>
        @foreach (var item in Model.Medication)
        {
            <div class="border-bottom py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@item.MedicationName</strong> · <span class="text-primary fw-semibold">@item.Dose</span> · @item.Route · Giờ uống: <strong>@item.ScheduledTime</strong>
                    <div class="small text-secondary mt-1">Thời hạn: @item.StartDate – @(item.EndDate?.ToString() ?? "Đang tiếp tục")</div>
                </div>
                <span class="status-badge @(item.IsActive ? "status-active" : "status-discharged")">
                    @(item.IsActive ? "Đang áp dụng" : "Đã dừng")
                </span>
            </div>
        }
        @if (!Model.Medication.Any())
        {
            <p class="text-secondary mb-0">Chưa có lịch dùng thuốc.</p>
        }
    </section>
}

@if (Model.Permissions.CanViewBilling)
{
    <section class="card p-4 mb-4">
        <div class="section-heading mb-3">
            <div>
                <p class="eyebrow mb-1"><i class="bi bi-receipt-cutoff"></i> TÀI CHÍNH & CÔNG NỢ</p>
                <h2 class="h5 fw-bold mb-0">Hóa đơn và thanh toán</h2>
            </div>
        </div>
        @foreach (var invoice in Model.Invoices)
        {
            decimal total = BillingService.Total(invoice);
            decimal paid = invoice.Payments.Sum(payment => payment.Amount);
            decimal debt = invoice.Status == InvoiceStatus.Cancelled ? 0 : total - paid;
            <div class="border rounded-3 p-3 mb-3 bg-light">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <strong class="fs-6">Kỳ @invoice.BillingPeriod.ToString("MM/yyyy") · Số HĐ: @invoice.Number</strong>
                    <span class="status-badge status-@invoice.Status.ToString().ToLowerInvariant()">@invoice.Status</span>
                </div>
                <p class="mb-1">Tổng <strong>@total.ToString("N2") đ</strong> · Đã thanh toán <strong class="text-success">@paid.ToString("N2") đ</strong> · Còn nợ: <strong class="text-danger">@debt.ToString("N2") đ</strong></p>
                @foreach (var item in invoice.Items)
                {
                    <p class="small text-secondary mb-1">• @item.Description · @decimal.Round(item.Quantity * item.UnitPrice, 2, MidpointRounding.AwayFromZero).ToString("N2") đ</p>
                }
                @foreach (var payment in invoice.Payments)
                {
                    <p class="small text-success mb-0"><i class="bi bi-check2-circle me-1"></i>Thanh toán @payment.PaidAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy") · @payment.Amount.ToString("N2") đ · Mã: @payment.Reference</p>
                }
            </div>
        }
        @if (!Model.Invoices.Any())
        {
            <p class="text-secondary mb-0">Chưa có hóa đơn đã phát hành.</p>
        }
    </section>
}

<div class="row-actions">
    @if (Model.Page > 1)
    {
        <a asp-route-id="@Model.Resident.Id" asp-route-page="@(Model.Page - 1)" class="btn btn-outline-secondary">Trước</a>
    }
    @if (new[] { Model.Health.Count, Model.Care.Count, Model.Medication.Count, Model.Invoices.Count }.Any(count => count == 10))
    {
        <a asp-route-id="@Model.Resident.Id" asp-route-page="@(Model.Page + 1)" class="btn btn-outline-primary">Sau</a>
    }
</div>
