@model PagedList<MedicationDay>
@{
    ViewData["Title"] = "Thuốc trong ngày";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-capsule-pill"></i> NURSING HOME · CẤP PHÁT THUỐC HẰNG NGÀY</p>
        <h1>Thuốc trong ngày</h1>
        <p class="text-secondary mb-0">Theo dõi các cử thuốc theo giờ trong ngày và ghi nhận trạng thái sử dụng thực tế (Taken / Missed / Refused).</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-calendar2-check me-1"></i> Toàn bộ lịch thuốc</a>
    </div>
</div>
<form method="get" class="filter-bar">
    <input type="date" name="date" value="@Context.Request.Query["date"]" class="form-control" aria-label="Ngày" />
    @foreach (var key in new[] { "residentId", "id" })
    {
        if (Context.Request.Query.ContainsKey(key))
        {
            <input type="hidden" name="@key" value="@Context.Request.Query[key]" />
        }
    }
    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc theo ngày</button>
</form>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Cư dân</th>
                    <th>Thuốc</th>
                    <th>Liều / đường dùng</th>
                    <th>Giờ</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Schedule.Resident.FullName</td>
                        <td class="fw-bold text-primary">@item.Schedule.MedicationName</td>
                        <td>@item.Schedule.Dose / <span class="badge text-bg-light border">@item.Schedule.Route</span></td>
                        <td class="fw-semibold">@item.Schedule.ScheduledTime</td>
                        <td>
                            <span class="status-badge status-@item.Status.ToString().ToLowerInvariant()">@item.Status</span>
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (item.Log is null)
                                {
                                    <a asp-action="Record" asp-route-scheduleId="@item.Schedule.Id" asp-route-date="@item.Date.ToString("yyyy-MM-dd")" class="btn btn-sm btn-primary">
                                        <i class="bi bi-check2-square me-1"></i> Ghi nhận
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
