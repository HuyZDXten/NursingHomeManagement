@model PagedList<VitalSign>
@{
    ViewData["Title"] = "Lịch sử sinh hiệu";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-heart-pulse-fill"></i> NURSING HOME · CHỈ SỐ SINH HIỆU</p>
        <h1>Lịch sử sinh hiệu</h1>
        <p class="text-secondary mb-0">Ghi nhận và theo dõi huyết áp, nhịp tim, thân nhiệt và độ bão hòa oxy máu (SpO2).</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Residents" asp-action="Details" asp-route-id="@ViewData["ResidentId"]" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Hồ sơ cư dân
        </a>
        <a asp-action="Create" asp-route-residentId="@ViewData["ResidentId"]" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> + Ghi sinh hiệu
        </a>
    </div>
</div>
<form method="get" class="filter-bar">
    <input type="date" name="date" value="@Context.Request.Query["date"]" class="form-control" aria-label="Ngày" />
    @foreach (var key in new[] { "residentId", "id" })
    {
        if (Context.Request.Query.ContainsKey(key))
        {
            <input type="hidden" name="@key" value="@Context.Request.Query[key]" />
        }
    }
    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc</button>
</form>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Huyết áp</th>
                    <th>Nhịp tim</th>
                    <th>Nhiệt độ</th>
                    <th>SpO2</th>
                    <th>Ghi chú</th>
                    <th>Người ghi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.RecordedAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge text-bg-light border">@item.Systolic / @item.Diastolic mmHg</span></td>
                        <td>@item.HeartRate bpm</td>
                        <td>@item.Temperature °C</td>
                        <td>@(item.SpO2.HasValue ? item.SpO2 + " %" : "—")</td>
                        <td>@item.Notes</td>
                        <td>@item.RecordedBy.FullName</td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
