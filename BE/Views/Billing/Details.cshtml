@model Invoice
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    decimal total = BillingService.Total(Model);
    decimal paid = Model.Payments.Sum(payment => payment.Amount);
    decimal debt = Model.Status == InvoiceStatus.Cancelled ? 0 : total - paid;
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-receipt"></i> HÓA ĐƠN · @Model.Status</p>
        <h1>@Model.Resident.FullName</h1>
        <p class="text-secondary mb-0">Số HĐ: <strong>@Model.Number</strong> · Kỳ @Model.BillingPeriod.ToString("MM/yyyy") · Hạn thanh toán @Model.DueDate.ToString("dd/MM/yyyy")</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <span class="status-badge status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status</span>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Danh sách hóa đơn</a>
    </div>
</div>
<div class="card p-4 mb-4">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Nội dung</th>
                    <th>Số lượng</th>
                    <th>Đơn giá</th>
                    <th>Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Description</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N2")</td>
                        <td class="fw-bold">@decimal.Round(item.Quantity * item.UnitPrice, 2, MidpointRounding.AwayFromZero).ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="invoice-totals mt-2">
        <span>Tổng: <strong>@total.ToString("N2") đ</strong></span>
        <span>Đã trả: <strong class="text-success">@paid.ToString("N2") đ</strong></span>
        <span>Còn nợ: <strong class="text-danger">@debt.ToString("N2") đ</strong></span>
    </div>
</div>
<div class="row-actions mb-4">
    @if (Model.Status == InvoiceStatus.Draft)
    {
        <a asp-action="AddItem" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-plus-circle me-1"></i> Thêm khoản phí</a>
        <form asp-action="Issue" asp-route-id="@Model.Id" method="post" data-confirm="Phát hành và khóa số tiền hóa đơn?">
            <button class="btn btn-primary" type="submit"><i class="bi bi-send-check me-1"></i> Phát hành</button>
        </form>
    }
    @if (User.IsInRole(Roles.Admin))
    {
        @if (Model.Status is InvoiceStatus.Unpaid or InvoiceStatus.PartiallyPaid)
        {
            <a asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-cash-coin me-1"></i> Ghi nhận thanh toán</a>
        }
        @if (!Model.Payments.Any() && Model.Status != InvoiceStatus.Cancelled)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" data-confirm="Hủy hóa đơn này? Lịch sử vẫn được giữ lại.">
                <button class="btn btn-outline-danger" type="submit"><i class="bi bi-x-circle me-1"></i> Hủy hóa đơn</button>
            </form>
        }
    }
</div>
<section class="card p-4">
    <h2 class="h5 fw-bold mb-3"><i class="bi bi-clock-history me-1 text-primary"></i> Lịch sử thanh toán</h2>
    @foreach (var payment in Model.Payments.OrderByDescending(item => item.PaidAt))
    {
        <p class="border-bottom py-2 mb-2">
            <i class="bi bi-check-circle-fill text-success me-1"></i>
            @payment.PaidAt.ToOffset(FacilityClock.Offset).ToString("dd/MM/yyyy HH:mm") · <strong>@payment.Amount.ToString("N2") đ</strong> · Tham chiếu: <span class="badge text-bg-light border">@payment.Reference</span>
        </p>
    }
    @if (!Model.Payments.Any())
    {
        <p class="text-secondary mb-0">Chưa có thanh toán.</p>
    }
</section>
