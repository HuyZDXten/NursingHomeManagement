@model PagedList<ResidentSubscription>
@{
    ViewData["Title"] = "Đăng ký gói";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-card-checklist"></i> NURSING HOME · HỢP ĐỒNG DỊCH VỤ</p>
        <h1>Đăng ký gói</h1>
        <p class="text-secondary mb-0">Quản lý thời hạn đăng ký gói dịch vụ và đơn giá thỏa thuận đã chốt cho từng cư dân.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Subscribe" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> + Đăng ký gói</a>
    </div>
</div>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Cư dân</th>
                    <th>Gói</th>
                    <th>Giá thỏa thuận</th>
                    <th>Bắt đầu</th>
                    <th>Kết thúc</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Resident.FullName</td>
                        <td class="text-primary fw-bold">@item.ServicePackage.Name</td>
                        <td class="fw-semibold">@item.AgreedMonthlyPrice.ToString("N0") đ</td>
                        <td>@item.StartDate</td>
                        <td>@(item.EndDate?.ToString() ?? "Đang hiệu lực")</td>
                        <td>
                            <div class="row-actions">
                                <form asp-controller="Billing" asp-action="EndSubscription" asp-route-id="@item.Id" method="post" data-confirm="Xác nhận kết thúc gói?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Kết thúc gói</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
