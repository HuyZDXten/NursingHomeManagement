@model PagedList<ApplicationUser>
@{
    ViewData["Title"] = "Tài khoản & phân quyền";
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-shield-lock-fill"></i> NURSING HOME · QUẢN TRỊ BẢO MẬT</p>
        <h1>Tài khoản & phân quyền</h1>
        <p class="text-secondary mb-0">Quản lý danh sách nhân sự và tài khoản người nhà cư dân, phân quyền vai trò và khóa/mở khóa truy cập.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill me-1"></i> + Tạo tài khoản</a>
    </div>
</div>
<form method="get" class="filter-bar">
    <input name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tìm theo họ tên hoặc email…" aria-label="Tìm kiếm" />
    @foreach (var key in new[] { "residentId", "id" })
    {
        if (Context.Request.Query.ContainsKey(key))
        {
            <input type="hidden" name="@key" value="@Context.Request.Query[key]" />
        }
    }
    <button class="btn btn-primary" type="submit"><i class="bi bi-funnel-fill me-1"></i> Lọc</button>
</form>
<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Đang hoạt động</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    string initial = !string.IsNullOrWhiteSpace(item.FullName) ? item.FullName[..1].ToUpperInvariant() : "U";
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="resident-avatar">@initial</span>
                                <span class="fw-bold">@item.FullName</span>
                            </div>
                        </td>
                        <td>@item.Email</td>
                        <td>
                            <span class="status-badge @(item.IsActive ? "status-active" : "status-cancelled")">
                                @(item.IsActive ? "Có" : "Không")
                            </span>
                        </td>
                        <td>
                            <div class="row-actions">
                                <a asp-controller="Users" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-sliders me-1"></i> Quyền & trạng thái
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-secondary py-5">Chưa có dữ liệu phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pagination" model="@((Model.Page, Model.TotalPages, Model.TotalCount))" />
