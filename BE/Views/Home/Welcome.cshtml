@model DashboardViewModel
@{
    ViewData["Title"] = "Trang chủ Viện dưỡng lão An Tâm";
}

<section class="hero-luxury mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="eyebrow"><i class="bi bi-stars"></i> AN TÂM LUXURY SENIOR RESIDENCE</span>
            <h1 class="mt-3 mb-3">Không gian dưỡng lão chuẩn 5 sao · Trọn vẹn yêu thương & bình an</h1>
            <p class="text-light opacity-75 fs-6 mb-4">
                Hệ sinh thái chăm sóc người cao tuổi toàn diện: kết hợp nghỉ dưỡng cao cấp, theo dõi sinh hiệu định kỳ,
                quản lý thuốc chuẩn phê duyệt y khoa và cổng thông tin kết nối gia đình minh bạch 24/7.
            </p>
            <div class="d-flex flex-wrap gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole(Roles.Family))
                    {
                        <a asp-controller="Family" asp-action="Index" class="btn btn-gold">
                            <i class="bi bi-house-heart-fill me-1"></i> Vào Cổng thông tin Gia đình
                        </a>
                    }
                    else if (User.IsInRole(Roles.Caregiver))
                    {
                        <a asp-controller="Caregiver" asp-action="Index" class="btn btn-gold">
                            <i class="bi bi-clipboard2-pulse-fill me-1"></i> Vào Không gian Ca trực
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-gold">
                            <i class="bi bi-grid-1x2-fill me-1"></i> Vào Bảng điều khiển Quản lý
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-gold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập Cổng thông tin
                    </a>
                }
                <a href="#goi-dich-vu" class="btn btn-outline-light">
                    <i class="bi bi-gem me-1"></i> Xem các gói dịch vụ
                </a>
                <a href="#quy-trinh" class="btn btn-outline-light">
                    <i class="bi bi-shield-check me-1"></i> Quy trình chăm sóc
                </a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small><i class="bi bi-people-fill me-1"></i> Cư dân đang lưu trú</small>
                        <strong>@Model.Residents</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small><i class="bi bi-door-open-fill me-1"></i> Phòng hoạt động</small>
                        <strong>@Model.Rooms</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small><i class="bi bi-hospital-fill me-1"></i> Giường sẵn sàng</small>
                        <strong>@Model.AvailableBeds / @Model.Beds</strong>
                    </div>
                </div>
                <div class="col-6">
                    <div class="hero-stat-pill">
                        <small><i class="bi bi-headset me-1"></i> Chăm sóc & Theo dõi</small>
                        <strong>24/7</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="section-heading">
        <div>
            <p class="eyebrow"><i class="bi bi-award"></i> TIÊU CHUẨN DỊCH VỤ</p>
            <h2 class="h3 fw-bold mb-1">Trải nghiệm chăm sóc tận tâm & minh bạch</h2>
            <p class="text-secondary mb-0">Mọi quy trình lưu trú, chăm sóc và sức khỏe đều được chuẩn hóa và cập nhật theo thời gian thực.</p>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card">
                <div class="metric-card-top">
                    <span class="metric-icon crimson"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span class="status-badge status-active">Chuẩn Y Khoa</span>
                </div>
                <div>
                    <h3 class="h5 fw-bold mt-2">Theo dõi Sinh hiệu</h3>
                    <p class="text-secondary mb-0">Ghi nhận huyết áp, nhịp tim, nhiệt độ, SpO2 định kỳ và chia sẻ trực tiếp cho gia đình theo phân quyền.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card">
                <div class="metric-card-top">
                    <span class="metric-icon"><i class="bi bi-capsule-pill"></i></span>
                    <span class="status-badge status-inprogress">An Toàn Kép</span>
                </div>
                <div>
                    <h3 class="h5 fw-bold mt-2">Quản lý Thuốc chặt chẽ</h3>
                    <p class="text-secondary mb-0">Lịch dùng thuốc hàng ngày kèm mã tham chiếu phê duyệt chuyên môn, đối chiếu từng lần uống.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card">
                <div class="metric-card-top">
                    <span class="metric-icon gold"><i class="bi bi-building-check"></i></span>
                    <span class="status-badge status-pending">Tiện Nghi 5 Sao</span>
                </div>
                <div>
                    <h3 class="h5 fw-bold mt-2">Không gian Nghỉ dưỡng</h3>
                    <p class="text-secondary mb-0">Phòng ở thoáng đãng, giường chăm sóc chuyên dụng, kiểm soát trạng thái bảo trì và vệ sinh nghiêm ngặt.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card metric-card">
                <div class="metric-card-top">
                    <span class="metric-icon teal"><i class="bi bi-people-fill"></i></span>
                    <span class="status-badge status-active">Kết Nối 24/7</span>
                </div>
                <div>
                    <h3 class="h5 fw-bold mt-2">Cổng thông tin Gia đình</h3>
                    <p class="text-secondary mb-0">Người thân tra cứu sức khỏe, nhật ký chăm sóc, lịch thuốc và hóa đơn mọi lúc mọi nơi.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="goi-dich-vu" class="mb-5">
    <div class="section-heading">
        <div>
            <p class="eyebrow"><i class="bi bi-gem"></i> DANH MỤC GÓI CHĂM SÓC</p>
            <h2 class="h3 fw-bold mb-1">Các gói dịch vụ lưu trú & chăm sóc hiện hành</h2>
            <p class="text-secondary mb-0">Chi phí minh bạch, chốt giá thỏa thuận khi đăng ký và tính phí chính xác theo ngày lưu trú thực tế.</p>
        </div>
        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
        {
            <a asp-controller="Billing" asp-action="Packages" class="btn btn-outline-primary">
                <i class="bi bi-gear me-1"></i> Quản lý gói dịch vụ
            </a>
        }
    </div>
    <div class="row g-4">
        @for (int i = 0; i < Model.Packages.Count; i++)
        {
            var pkg = Model.Packages[i];
            bool isFeatured = i == 0;
            <div class="col-md-6 col-lg-4">
                <div class="package-card @(isFeatured ? "featured" : "")">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="status-badge @(isFeatured ? "status-pending" : "status-inprogress")">
                                <i class="bi @(isFeatured ? "bi-star-fill" : "bi-shield-check")"></i>
                                @(isFeatured ? "Gói Tiêu chuẩn / Phổ biến" : "Gói Chăm sóc Chuyên biệt")
                            </span>
                            <span class="text-secondary small">Mã #@pkg.Id</span>
                        </div>
                        <h3 class="h4 fw-bold mb-2">@pkg.Name</h3>
                        <div class="package-price mb-3">
                            @pkg.MonthlyPrice.ToString("N0") đ <small>/ tháng</small>
                        </div>
                        <p class="text-secondary mb-4">
                            @(string.IsNullOrWhiteSpace(pkg.Description)
                                ? "Bao gồm lưu trú phòng tiêu chuẩn, chăm sóc sinh hoạt hàng ngày, theo dõi sinh hiệu định kỳ và kết nối thông tin gia đình."
                                : pkg.Description)
                        </p>
                        <ul class="list-unstyled small text-secondary d-grid gap-2 mb-4">
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Chăm sóc sinh hoạt & dinh dưỡng hàng ngày</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Theo dõi sinh hiệu & nhật ký điều dưỡng</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Quản lý lịch uống thuốc theo phê duyệt</li>
                            <li><i class="bi bi-check-circle-fill text-success me-2"></i>Tài khoản Family theo dõi trực tuyến</li>
                        </ul>
                    </div>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="small text-secondary"><i class="bi bi-calendar-check me-1"></i> Đang cung cấp</span>
                        @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
                        {
                            <a asp-controller="Billing" asp-action="Subscribe" class="btn btn-sm btn-primary">Đăng ký cho cư dân</a>
                        }
                        else if (User.IsInRole(Roles.Family))
                        {
                            <a asp-controller="Family" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem người thân</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">Đăng nhập tư vấn</a>
                        }
                    </div>
                </div>
            </div>
        }
        @if (!Model.Packages.Any())
        {
            <div class="col-12">
                <div class="card p-5 text-center text-secondary">
                    <i class="bi bi-gem fs-1 text-primary mb-2"></i>
                    <p class="mb-0">Danh mục gói dịch vụ đang được cập nhật. Vui lòng liên hệ bộ phận Lễ tân để được tư vấn trực tiếp.</p>
                </div>
            </div>
        }
    </div>
</section>

<section id="quy-trinh" class="row g-4">
    <div class="col-lg-7">
        <div class="card p-4 h-100">
            <p class="eyebrow"><i class="bi bi-diagram-3"></i> QUY TRÌNH KHÉP KÍN</p>
            <h2 class="h4 fw-bold mb-3">4 bước tiếp nhận & đồng hành cùng gia đình</h2>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <span class="badge text-bg-primary mb-2">Bước 01</span>
                        <h3 class="h6 fw-bold">Tiếp nhận & Lập hồ sơ</h3>
                        <p class="small text-secondary mb-0">Ghi nhận thông tin cư dân, người liên hệ khẩn cấp và thiết lập tài khoản Family.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <span class="badge text-bg-primary mb-2">Bước 02</span>
                        <h3 class="h6 fw-bold">Phân giường & Chọn gói</h3>
                        <p class="small text-secondary mb-0">Bố trí phòng/giường phù hợp và chốt giá gói dịch vụ minh bạch theo thỏa thuận.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <span class="badge text-bg-primary mb-2">Bước 03</span>
                        <h3 class="h6 fw-bold">Chăm sóc & Theo dõi Y tế</h3>
                        <p class="small text-secondary mb-0">Điều dưỡng thực hiện công việc hàng ngày, đo sinh hiệu và ghi nhận thuốc đúng giờ.</p>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <span class="badge text-bg-primary mb-2">Bước 04</span>
                        <h3 class="h6 fw-bold">Cập nhật Gia đình 24/7</h3>
                        <p class="small text-secondary mb-0">Gia đình xem báo cáo sức khỏe, lịch sử chăm sóc và hóa đơn trực tiếp trên cổng thông tin.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-4 h-100" style="background: linear-gradient(145deg, #0f2747 0%, #173763 100%); color: #fff;">
            <p class="eyebrow" style="color: var(--gold-light);"><i class="bi bi-telephone-inbound"></i> THÔNG TIN HỖ TRỢ</p>
            <h2 class="h4 fw-bold text-white mb-3">Liên hệ & Giờ thăm khám</h2>
            <p class="small text-light opacity-75 mb-4">
                Đội ngũ Lễ tân và Điều dưỡng luôn sẵn sàng hỗ trợ gia đình thăm hỏi, tư vấn chế độ chăm sóc và giải đáp thông tin lưu trú.
            </p>
            <div class="d-grid gap-3 small">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.08);">
                    <i class="bi bi-clock-history fs-4 text-warning"></i>
                    <div>
                        <strong class="d-block text-white">Giờ thăm thân hàng ngày</strong>
                        <span class="text-light opacity-75">Sáng: 08:00 – 11:30 · Chiều: 14:00 – 17:30</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.08);">
                    <i class="bi bi-telephone-fill fs-4 text-warning"></i>
                    <div>
                        <strong class="d-block text-white">Tổng đài Hỗ trợ & Trực Y tế</strong>
                        <span class="text-light opacity-75">1900 6868 · Trực cấp cứu nội viện 24/7</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 p-3 rounded-3" style="background: rgba(255,255,255,0.08);">
                    <i class="bi bi-geo-alt-fill fs-4 text-warning"></i>
                    <div>
                        <strong class="d-block text-white">Khuôn viên An Tâm Residence</strong>
                        <span class="text-light opacity-75">Khu sinh thái An Tâm, TP. Hồ Chí Minh (UTC+7)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
