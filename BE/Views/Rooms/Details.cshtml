@model Room
@{
    ViewData["Title"] = "Phòng " + Model.Number;
}
<div class="page-heading">
    <div>
        <p class="eyebrow"><i class="bi bi-hospital-fill"></i> PHÒNG & GIƯỜNG · SƠ ĐỒ GIƯỜNG</p>
        <h1>Phòng @Model.Number</h1>
        <p class="text-secondary mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Khu vực lưu trú tiêu chuẩn" : Model.Description)</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Danh sách phòng</a>
        <a asp-controller="Beds" asp-action="Create" asp-route-roomId="@Model.Id" class="btn btn-primary">+ Thêm giường</a>
    </div>
</div>
<div class="row g-4">
    @foreach (var bed in Model.Beds.OrderBy(item => item.Number))
    {
        string tone = bed.Status == BedStatus.Available ? "status-available"
            : bed.Status == BedStatus.Occupied ? "status-occupied"
            : "status-maintenance";
        string icon = bed.Status == BedStatus.Available ? "bi-check-circle-fill"
            : bed.Status == BedStatus.Occupied ? "bi-person-fill-check"
            : "bi-tools";
        <div class="col-md-6 col-xl-4">
            <div class="card p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="text-secondary small">Phòng @Model.Number</span>
                        <h2 class="h4 fw-bold mb-0">Giường @bed.Number</h2>
                    </div>
                    <span class="status-badge @tone"><i class="bi @icon"></i> @bed.Status</span>
                </div>
                <p class="text-secondary small mb-4">
                    @(bed.Status == BedStatus.Available ? "Giường đang trống, sẵn sàng tiếp nhận cư dân mới."
                        : bed.Status == BedStatus.Occupied ? "Giường đang có cư dân lưu trú."
                        : "Giường đang trong trạng thái bảo trì kỹ thuật.")
                </p>
                <div class="row-actions mt-auto pt-3 border-top">
                    <a asp-controller="Beds" asp-action="Edit" asp-route-id="@bed.Id" class="btn btn-outline-primary btn-sm">Chỉnh sửa</a>
                    <form asp-controller="Beds" asp-action="Delete" asp-route-id="@bed.Id" method="post" data-confirm="Xóa giường chưa có lịch sử?">
                        <button class="btn btn-outline-danger btn-sm" type="submit">Xóa</button>
                    </form>
                </div>
            </div>
        </div>
    }
    @if (!Model.Beds.Any())
    {
        <div class="col-12">
            <div class="card p-5 text-center text-secondary">
                Chưa có giường nào trong phòng này. Nhấn <strong>+ Thêm giường</strong> để khởi tạo.
            </div>
        </div>
    }
</div>
