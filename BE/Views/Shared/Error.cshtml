@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<div class="card p-5 text-center mx-auto" style="max-width: 680px;">
    <div class="mb-3">
        <span class="metric-icon crimson mx-auto" style="width:64px;height:64px;font-size:1.8rem;">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </span>
    </div>
    <p class="eyebrow justify-content-center text-danger">HỆ THỐNG GẶP SỰ CỐ</p>
    <h1 class="h3 fw-bold mb-2">Đã xảy ra lỗi trong quá trình xử lý yêu cầu</h1>
    <p class="text-secondary mb-4">
        Vui lòng thử lại thao tác hoặc quay về trang chủ. Nếu sự cố tiếp diễn, hãy cung cấp mã yêu cầu bên dưới cho quản trị viên.
    </p>
    @if (Model.ShowRequestId)
    {
        <div class="p-3 rounded-3 bg-light border mb-4 d-inline-block mx-auto">
            <span class="text-secondary small">Mã truy vết (Request ID):</span>
            <code class="ms-1 fw-bold">@Model.RequestId</code>
        </div>
    }
    <div class="d-flex justify-content-center gap-2 flex-wrap">
        <a asp-controller="Home" asp-action="Welcome" class="btn btn-primary">
            <i class="bi bi-house-heart me-1"></i> Trang chủ Viện dưỡng lão
        </a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>
