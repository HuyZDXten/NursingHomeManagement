@model MedicationLogForm

<div class="row g-4">
    <input asp-for="ScheduleId" type="hidden" />
    <div class="col-md-6">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="Taken">Taken</option>
            <option value="Missed">Missed</option>
            <option value="Refused">Refused</option>
        </select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ghi chú tình trạng uống thuốc (bắt buộc nhập lý do nếu Missed hoặc Refused)…"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
