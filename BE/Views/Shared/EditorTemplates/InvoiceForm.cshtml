@model InvoiceForm

<div class="row g-4">
    <div class="col-md-12">
        <label asp-for="ResidentId" class="form-label"></label>
        <select asp-for="ResidentId" asp-items='ViewBag.ResidentIdOptions' class="form-select">
            <option value="">— Chọn cư dân —</option>
        </select>
        <span asp-validation-for="ResidentId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BillingPeriod" class="form-label"></label>
        <input asp-for="BillingPeriod" class="form-control" />
        <span asp-validation-for="BillingPeriod" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger small"></span>
    </div>
</div>
