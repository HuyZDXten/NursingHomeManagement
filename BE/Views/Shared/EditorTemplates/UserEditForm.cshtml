@model UserEditForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="@(new SelectList(Roles.All))" class="form-select"></select>
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="p-3 rounded-3 bg-light border">
            <div class="form-check m-0">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                <div class="small text-secondary">Nếu bỏ chọn, tài khoản sẽ bị khóa và phiên đăng nhập hiện tại sẽ hết hiệu lực ngay lập tức.</div>
            </div>
        </div>
    </div>
</div>
