@model BedAssignmentForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="ResidentId" class="form-label"></label>
        <select asp-for="ResidentId" asp-items='ViewBag.ResidentIdOptions' class="form-select">
            <option value="">— Chọn cư dân —</option>
        </select>
        <span asp-validation-for="ResidentId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="BedId" class="form-label"></label>
        <select asp-for="BedId" asp-items='ViewBag.BedIdOptions' class="form-select">
            <option value="">— Chọn giường trống khả dụng —</option>
        </select>
        <span asp-validation-for="BedId" class="text-danger small"></span>
    </div>
</div>
