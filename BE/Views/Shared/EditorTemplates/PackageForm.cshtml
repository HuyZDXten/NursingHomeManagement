@model PackageForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Tên gói chăm sóc" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MonthlyPrice" class="form-label"></label>
        <input asp-for="MonthlyPrice" class="form-control" step="0.01" placeholder="Đơn giá hàng tháng (VNĐ)" />
        <span asp-validation-for="MonthlyPrice" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Chi tiết quyền lợi, chế độ dinh dưỡng và dịch vụ chăm sóc bao gồm trong gói…"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="p-3 rounded-3 bg-light border">
            <div class="form-check m-0">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                <div class="small text-secondary">Hiển thị trên Trang chủ người dùng và cho phép đăng ký mới.</div>
            </div>
        </div>
    </div>
</div>
