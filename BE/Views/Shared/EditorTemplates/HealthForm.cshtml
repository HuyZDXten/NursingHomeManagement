@model HealthForm

<div class="row g-4">
    <div class="col-12">
        <label asp-for="ResidentId" class="form-label"></label>
        <select asp-for="ResidentId" asp-items='ViewBag.ResidentIdOptions' class="form-select">
            <option value="">— Chọn cư dân —</option>
        </select>
        <span asp-validation-for="ResidentId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Systolic" class="form-label"></label>
        <input asp-for="Systolic" class="form-control" placeholder="mmHg (40 – 300)" />
        <span asp-validation-for="Systolic" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Diastolic" class="form-label"></label>
        <input asp-for="Diastolic" class="form-control" placeholder="mmHg (20 – 200)" />
        <span asp-validation-for="Diastolic" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="HeartRate" class="form-label"></label>
        <input asp-for="HeartRate" class="form-control" placeholder="Nhịp/phút (bpm)" />
        <span asp-validation-for="HeartRate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Temperature" class="form-label"></label>
        <input asp-for="Temperature" class="form-control" step="0.01" placeholder="°C" />
        <span asp-validation-for="Temperature" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SpO2" class="form-label"></label>
        <input asp-for="SpO2" class="form-control" step="0.01" placeholder="%" />
        <span asp-validation-for="SpO2" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Nhận xét lâm sàng hoặc biểu hiện của cư dân lúc đo…"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="p-3 rounded-3 bg-light border">
            <div class="form-check m-0">
                <input asp-for="ShareWithFamily" class="form-check-input" />
                <label asp-for="ShareWithFamily" class="form-check-label fw-semibold"></label>
                <div class="small text-secondary">Nếu bật, tài khoản Family có quyền xem Sức khỏe sẽ thấy bản ghi này.</div>
            </div>
        </div>
    </div>
</div>
