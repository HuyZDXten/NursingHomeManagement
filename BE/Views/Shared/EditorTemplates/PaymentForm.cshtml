@model PaymentForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" step="0.01" placeholder="Số tiền thực thu (VNĐ)" />
        <span asp-validation-for="Amount" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Reference" class="form-label"></label>
        <input asp-for="Reference" class="form-control" placeholder="Mã phiếu thu / tham chiếu giao dịch duy nhất" />
        <span asp-validation-for="Reference" class="text-danger small"></span>
    </div>
</div>
