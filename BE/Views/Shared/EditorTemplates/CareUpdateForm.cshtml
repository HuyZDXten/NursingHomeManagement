@model CareUpdateForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="InProgress">InProgress</option>
            <option value="Completed">Completed</option>
            @if (User.IsInRole(Roles.Admin))
            {
                <option value="Cancelled">Cancelled</option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Result" class="form-label"></label>
        <textarea asp-for="Result" class="form-control" rows="3" placeholder="Mô tả kết quả chăm sóc hoặc lý do cập nhật trạng thái…"></textarea>
        <span asp-validation-for="Result" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="p-3 rounded-3 bg-light border">
            <div class="form-check m-0">
                <input asp-for="ShareWithFamily" class="form-check-input" />
                <label asp-for="ShareWithFamily" class="form-check-label fw-semibold"></label>
                <div class="small text-secondary">Cho phép hiển thị kết quả chăm sóc này trên Cổng thông tin Gia đình.</div>
            </div>
        </div>
    </div>
    <input asp-for="RowVersion" type="hidden" />
</div>
