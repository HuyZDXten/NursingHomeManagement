@model MedicationForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="ResidentId" class="form-label"></label>
        <select asp-for="ResidentId" asp-items='ViewBag.ResidentIdOptions' class="form-select">
            <option value="">— Chọn cư dân —</option>
        </select>
        <span asp-validation-for="ResidentId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ApprovalReference" class="form-label"></label>
        <input asp-for="ApprovalReference" class="form-control" placeholder="VD: BS-2026-108 / Mã y lệnh phê duyệt" />
        <span asp-validation-for="ApprovalReference" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="MedicationName" class="form-label"></label>
        <input asp-for="MedicationName" class="form-control" placeholder="Tên thuốc" />
        <span asp-validation-for="MedicationName" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Dose" class="form-label"></label>
        <input asp-for="Dose" class="form-control" placeholder="VD: 1 viên (5mg)" />
        <span asp-validation-for="Dose" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Route" class="form-label"></label>
        <input asp-for="Route" class="form-control" placeholder="VD: Uống sau ăn" />
        <span asp-validation-for="Route" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ScheduledTime" class="form-label"></label>
        <input asp-for="ScheduledTime" class="form-control" type="time" />
        <span asp-validation-for="ScheduledTime" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="Instructions" class="form-label"></label>
        <textarea asp-for="Instructions" class="form-control" rows="3" placeholder="Hướng dẫn sử dụng và theo dõi sau dùng thuốc…"></textarea>
        <span asp-validation-for="Instructions" class="text-danger small"></span>
    </div>
</div>
