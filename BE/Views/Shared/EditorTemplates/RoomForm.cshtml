@model RoomForm

<div class="row g-4">
    <div class="col-md-6">
        <label asp-for="Number" class="form-label"></label>
        <input asp-for="Number" class="form-control" placeholder="VD: P-101, VIP-201…" />
        <span asp-validation-for="Number" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <div class="p-3 rounded-3 bg-light border h-100 d-flex align-items-center">
            <div class="form-check m-0">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label fw-semibold"></label>
                <div class="small text-secondary">Cho phép phân giường và tiếp nhận cư dân vào phòng này.</div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mô tả loại phòng, tầng, tiện nghi đi kèm…"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
