@model (int Page, int TotalPages, int TotalCount)
@{
    string PageUrl(int page)
    {
        var values = Context.Request.Query.ToDictionary(item => item.Key, item => (string?)item.Value.ToString());
        values["page"] = page.ToString();
        return Context.Request.Path + Microsoft.AspNetCore.Http.QueryString.Create(values);
    }
}
<nav class="pagination-bar" aria-label="Phân trang">
    <span><i class="bi bi-layers me-1"></i> Tổng <strong>@Model.TotalCount</strong> bản ghi · Trang <strong>@Model.Page</strong> / @Model.TotalPages</span>
    <div class="d-flex gap-2">
        @if (Model.Page > 1)
        {
            <a href="@PageUrl(Model.Page - 1)" class="btn btn-outline-secondary btn-sm"><i class="bi bi-chevron-left me-1"></i> Trước</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a href="@PageUrl(Model.Page + 1)" class="btn btn-outline-primary btn-sm">Sau <i class="bi bi-chevron-right ms-1"></i></a>
        }
    </div>
</nav>
