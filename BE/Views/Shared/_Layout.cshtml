<!DOCTYPE html>
<html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] · An Tâm Nursing Home</title>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <style>
            :root {
                --navy-deep: #09192f;
                --navy: #0f2747;
                --navy-mid: #173763;
                --blue: #1d5fd6;
                --blue-hover: #164db0;
                --blue-soft: #eef4ff;
                --gold: #c69a38;
                --gold-light: #e5c165;
                --gold-soft: #fdf8ec;
                --teal: #0d9488;
                --teal-soft: #ecfdf5;
                --crimson: #dc2626;
                --crimson-soft: #fef2f2;
                --amber: #d97706;
                --amber-soft: #fffbeb;
                --bg-main: #f4f7fb;
                --surface: #ffffff;
                --border: #e3e8f2;
                --border-strong: #cbd5e1;
                --text-main: #0f172a;
                --text-secondary: #475569;
                --muted: #64748b;
                --shadow-sm: 0 2px 8px rgba(15, 39, 71, 0.04), 0 1px 2px rgba(15, 39, 71, 0.03);
                --shadow-md: 0 10px 28px rgba(15, 39, 71, 0.07), 0 2px 6px rgba(15, 39, 71, 0.04);
                --shadow-lg: 0 20px 45px rgba(9, 25, 47, 0.12), 0 4px 12px rgba(9, 25, 47, 0.06);
                --radius-sm: 10px;
                --radius-md: 16px;
                --radius-lg: 22px;
            }
            body {
                background: radial-gradient(circle at 100% 0%, #ebf1fa 0%, var(--bg-main) 45%, #f8fafd 100%);
                color: var(--text-main);
                font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
            }
            .app-shell { display: flex; min-height: 100vh; }
            .sidebar {
                width: 285px;
                background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 55%, #0b1e38 100%);
                color: #ffffff;
                padding: 28px 20px;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                border-right: 1px solid rgba(255, 255, 255, 0.08);
                box-shadow: 4px 0 24px rgba(9, 25, 47, 0.15);
                position: sticky;
                top: 0;
                height: 100vh;
                overflow-y: auto;
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
                font-size: 1.2rem;
                font-weight: 800;
                letter-spacing: -0.02em;
                margin-bottom: 24px;
                padding-bottom: 20px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
                color: #ffffff;
                text-decoration: none;
            }
            .brand:hover { color: #ffffff; }
            .brand-text { display: flex; flex-direction: column; line-height: 1.2; }
            .brand small {
                display: block;
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 0.14em;
                color: var(--gold-light);
                margin-top: 5px;
                text-transform: uppercase;
            }
            .brand-mark {
                width: 44px;
                height: 44px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--gold) 0%, #9e751d 100%);
                color: #ffffff;
                font-size: 1.3rem;
                box-shadow: 0 6px 16px rgba(198, 154, 56, 0.35);
                flex-shrink: 0;
            }
            .sidebar-role-card {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(229, 193, 101, 0.25);
                border-radius: 14px;
                padding: 12px 14px;
                margin-bottom: 22px;
                display: flex;
                align-items: center;
                gap: 12px;
            }
            .sidebar-role-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: rgba(229, 193, 101, 0.16);
                color: var(--gold-light);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.05rem;
                flex-shrink: 0;
            }
            .sidebar-role-info { min-width: 0; }
            .sidebar-role-label {
                font-size: 0.65rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: #94a3b8;
                display: block;
            }
            .sidebar-role-name {
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--gold-light);
                display: block;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }
            .nav-section-title {
                font-size: 0.66rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.14em;
                color: #7c93b2;
                padding: 10px 12px 4px;
                margin-top: 6px;
            }
            .sidebar nav { display: flex; flex-direction: column; gap: 4px; flex: 1; }
            .sidebar nav a {
                display: flex;
                align-items: center;
                gap: 11px;
                color: #cbd5e1;
                padding: 11px 14px;
                border-radius: 11px;
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
                transition: all 0.2s ease;
                border: 1px solid transparent;
            }
            .sidebar nav a i { font-size: 1.05rem; color: #94a3b8; transition: color 0.2s ease; }
            .sidebar nav a:hover {
                color: #ffffff;
                background: rgba(255, 255, 255, 0.08);
                transform: translateX(2px);
            }
            .sidebar nav a:hover i { color: var(--gold-light); }
            .sidebar nav a.active {
                color: #ffffff;
                font-weight: 600;
                background: linear-gradient(90deg, rgba(29, 95, 214, 0.38) 0%, rgba(255, 255, 255, 0.08) 100%);
                border-color: rgba(229, 193, 101, 0.35);
                box-shadow: inset 3px 0 0 var(--gold-light);
            }
            .sidebar nav a.active i { color: var(--gold-light); }
            .sidebar-note {
                margin-top: 24px;
                padding: 16px;
                border-radius: 14px;
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(198, 154, 56, 0.1) 100%);
                border: 1px solid rgba(255, 255, 255, 0.08);
                font-size: 0.8rem;
                color: #cbd5e1;
                line-height: 1.6;
            }
            .sidebar-note strong { color: var(--gold-light); display: block; margin-bottom: 4px; font-size: 0.82rem; }
            .main-panel { flex: 1; min-width: 0; display: flex; flex-direction: column; }
            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                background: rgba(255, 255, 255, 0.92);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border);
                padding: 16px 36px;
                font-size: 0.88rem;
                flex-wrap: wrap;
                position: sticky;
                top: 0;
                z-index: 30;
            }
            .topbar-brand-group { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
            .topbar-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 5px 12px;
                border-radius: 999px;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.03em;
                background: var(--gold-soft);
                color: #8a6412;
                border: 1px solid rgba(198, 154, 56, 0.35);
            }
            .account-area, .row-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
            .user-pill {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                padding: 6px 14px 6px 8px;
                background: #f8fafc;
                border: 1px solid var(--border);
                border-radius: 999px;
                font-weight: 600;
                color: var(--navy);
            }
            .user-avatar-sm {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.78rem;
                font-weight: 700;
            }
            .page-heading, .section-heading {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
                flex-wrap: wrap;
                margin-bottom: 26px;
            }
            .page-heading {
                background: linear-gradient(135deg, #ffffff 0%, #f8fafd 100%);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                padding: 24px 28px;
                box-shadow: var(--shadow-sm);
                position: relative;
                overflow: hidden;
            }
            .page-heading::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 5px;
                background: linear-gradient(180deg, var(--gold) 0%, var(--blue) 100%);
            }
            h1 { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.025em; color: var(--navy-deep); margin-bottom: 4px; }
            .eyebrow {
                color: var(--gold);
                font-size: 0.72rem;
                font-weight: 800;
                letter-spacing: 0.15em;
                text-transform: uppercase;
                margin-bottom: 6px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }
            .hero-luxury {
                background: linear-gradient(130deg, var(--navy-deep) 0%, var(--navy) 55%, #194175 100%);
                color: #ffffff;
                border-radius: var(--radius-lg);
                padding: 38px 42px;
                margin-bottom: 28px;
                position: relative;
                overflow: hidden;
                box-shadow: var(--shadow-lg);
                border: 1px solid rgba(229, 193, 101, 0.25);
            }
            .hero-luxury h1 { color: #ffffff; font-size: 2.15rem; line-height: 1.25; }
            .hero-luxury .eyebrow {
                color: var(--gold-light);
                background: rgba(229, 193, 101, 0.14);
                border: 1px solid rgba(229, 193, 101, 0.3);
                padding: 5px 12px;
                border-radius: 999px;
            }
            .hero-stat-pill {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.14);
                border-radius: 14px;
                padding: 14px 18px;
                backdrop-filter: blur(8px);
            }
            .hero-stat-pill small { display: block; color: #cbd5e1; font-size: 0.75rem; }
            .hero-stat-pill strong { font-size: 1.35rem; color: var(--gold-light); font-weight: 800; }
            .card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                box-shadow: var(--shadow-sm);
                transition: transform 0.18s ease, box-shadow 0.18s ease;
            }
            .metric-card {
                padding: 24px;
                height: 100%;
                position: relative;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }
            .metric-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
            .metric-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
            .metric-icon {
                width: 46px;
                height: 46px;
                border-radius: 13px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 1.3rem;
                background: var(--blue-soft);
                color: var(--blue);
                flex-shrink: 0;
            }
            .metric-icon.gold { background: var(--gold-soft); color: #a17415; }
            .metric-icon.teal { background: var(--teal-soft); color: var(--teal); }
            .metric-icon.crimson { background: var(--crimson-soft); color: var(--crimson); }
            .metric-card p { color: var(--text-secondary); font-size: 0.86rem; font-weight: 600; margin-bottom: 6px; }
            .metric-card strong { font-size: 1.85rem; font-weight: 800; color: var(--navy-deep); letter-spacing: -0.03em; line-height: 1.15; }
            .package-card {
                border-radius: var(--radius-md);
                border: 1px solid var(--border);
                background: linear-gradient(180deg, #ffffff 0%, #fcfdff 100%);
                padding: 28px;
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                box-shadow: var(--shadow-sm);
                transition: all 0.22s ease;
            }
            .package-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: rgba(198, 154, 56, 0.5); }
            .package-card.featured { border: 2px solid var(--gold); background: linear-gradient(180deg, #fffdf7 0%, #ffffff 100%); }
            .package-price { font-size: 1.9rem; font-weight: 800; color: var(--navy-deep); letter-spacing: -0.03em; }
            .package-price small { font-size: 0.85rem; font-weight: 500; color: var(--muted); }
            .status-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 5px 12px;
                border-radius: 999px;
                font-size: 0.76rem;
                font-weight: 700;
                letter-spacing: 0.02em;
                white-space: nowrap;
            }
            .status-active, .status-completed, .status-paid, .status-taken, .status-available { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
            .status-pending, .status-scheduled, .status-unpaid, .status-partiallypaid { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
            .status-inprogress, .status-occupied { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
            .status-cancelled, .status-missed, .status-refused, .status-maintenance { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
            .status-discharged, .status-draft { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
            .login-wrapper { max-width: 1120px; margin: 1.5vh auto; }
            .login-showcase {
                background: linear-gradient(145deg, var(--navy-deep) 0%, var(--navy) 55%, #173a6a 100%);
                color: #ffffff;
                border-radius: var(--radius-lg);
                padding: 42px;
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                box-shadow: var(--shadow-lg);
                border: 1px solid rgba(229, 193, 101, 0.3);
                position: relative;
                overflow: hidden;
            }
            .login-showcase::after {
                content: "";
                position: absolute;
                right: -50px;
                bottom: -50px;
                width: 240px;
                height: 240px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(229, 193, 101, 0.22) 0%, rgba(229, 193, 101, 0) 70%);
                pointer-events: none;
            }
            .login-card {
                max-width: 520px;
                width: 100%;
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                border: 1px solid var(--border);
                background: #ffffff;
            }
            .role-quick-btn {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.16);
                color: #ffffff;
                border-radius: 12px;
                padding: 10px 12px;
                text-align: left;
                transition: all 0.18s ease;
                cursor: pointer;
                width: 100%;
            }
            .role-quick-btn:hover {
                background: rgba(229, 193, 101, 0.2);
                border-color: var(--gold-light);
                transform: translateY(-2px);
            }
            .form-card { max-width: 940px; border-radius: var(--radius-md); box-shadow: var(--shadow-md); }
            .form-actions { display: flex; gap: 12px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--border); }
            .form-label { font-weight: 600; font-size: 0.88rem; color: var(--navy); margin-bottom: 6px; }
            .form-control, .form-select {
                padding: 11px 14px;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border-strong);
                font-size: 0.92rem;
            }
            .form-control:focus, .form-select:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(29, 95, 214, 0.14);
            }
            .filter-bar {
                display: flex;
                gap: 12px;
                margin-bottom: 22px;
                flex-wrap: wrap;
                background: #ffffff;
                padding: 16px 20px;
                border-radius: var(--radius-md);
                border: 1px solid var(--border);
                box-shadow: var(--shadow-sm);
                align-items: center;
            }
            .filter-bar .form-control, .filter-bar .form-select { max-width: 280px; }
            .table-card { overflow: hidden; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
            .table th {
                background: #f8fafc;
                color: var(--muted);
                font-size: 0.74rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                padding: 16px 18px;
                white-space: nowrap;
                border-bottom: 1px solid var(--border);
            }
            .table td { padding: 16px 18px; font-size: 0.9rem; color: var(--text-main); border-bottom: 1px solid #f1f5f9; }
            .table tbody tr:hover { background-color: #f8fbff; }
            .resident-avatar {
                width: 38px;
                height: 38px;
                border-radius: 11px;
                background: linear-gradient(135deg, var(--navy) 0%, var(--blue) 100%);
                color: #ffffff;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 0.9rem;
                flex-shrink: 0;
            }
            .resident-avatar.gold { background: linear-gradient(135deg, var(--gold) 0%, #9a7018 100%); }
            .pagination-bar { display: flex; align-items: center; justify-content: space-between; padding: 18px 4px; color: var(--muted); font-size: 0.86rem; font-weight: 500; }
            .invoice-totals { display: flex; justify-content: flex-end; gap: 24px; flex-wrap: wrap; background: #f8fafc; padding: 18px 22px; border-radius: 12px; border: 1px solid var(--border); }
            .btn { border-radius: 10px; font-weight: 600; padding: 9px 16px; transition: all 0.18s ease; }
            .btn-sm { padding: 6px 12px; font-size: 0.82rem; border-radius: 8px; }
            .btn-primary {
                background: linear-gradient(135deg, var(--blue) 0%, #1548a8 100%);
                border-color: var(--blue);
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(29, 95, 214, 0.22);
            }
            .btn-primary:hover {
                background: linear-gradient(135deg, var(--blue-hover) 0%, var(--navy) 100%);
                border-color: var(--blue-hover);
                color: #ffffff;
                transform: translateY(-1px);
            }
            .btn-gold {
                background: linear-gradient(135deg, var(--gold) 0%, #a3791f 100%);
                color: #ffffff;
                border: none;
                box-shadow: 0 4px 14px rgba(198, 154, 56, 0.3);
            }
            .btn-gold:hover {
                background: linear-gradient(135deg, #d4a843 0%, #8f6817 100%);
                color: #ffffff;
                transform: translateY(-1px);
            }
            .app-footer {
                background: #ffffff;
                border-top: 1px solid var(--border);
                padding: 18px 36px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 12px;
                color: var(--muted);
                font-size: 0.82rem;
            }
        </style>
    </head>
    <body>
        @{
            string roleTitle = User.IsInRole(Roles.Admin) ? "Quản trị viên (Admin)"
                : User.IsInRole(Roles.Receptionist) ? "Lễ tân & Tiếp đón"
                : User.IsInRole(Roles.Caregiver) ? "Điều dưỡng Chăm sóc"
                : User.IsInRole(Roles.Family) ? "Gia đình & Người thân"
                : "Khách tham quan";
            string roleIcon = User.IsInRole(Roles.Admin) ? "bi-award-fill"
                : User.IsInRole(Roles.Receptionist) ? "bi-person-check-fill"
                : User.IsInRole(Roles.Caregiver) ? "bi-heart-pulse-fill"
                : User.IsInRole(Roles.Family) ? "bi-house-heart-fill"
                : "bi-compass";
            string userInitial = !string.IsNullOrWhiteSpace(User.Identity?.Name)
                ? User.Identity.Name[..1].ToUpperInvariant()
                : "U";
        }
        <div class="app-shell">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <aside class="sidebar">
                    <a class="brand" asp-controller="Home" asp-action="Welcome">
                        <span class="brand-mark"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i></span>
                        <span class="brand-text">
                            An Tâm Residence
                            <small>LUXURY NURSING HOME</small>
                        </span>
                    </a>
                    <div class="sidebar-role-card">
                        <div class="sidebar-role-icon">
                            <i class="bi @roleIcon" aria-hidden="true"></i>
                        </div>
                        <div class="sidebar-role-info">
                            <span class="sidebar-role-label">Không gian vai trò</span>
                            <span class="sidebar-role-name">@roleTitle</span>
                        </div>
                    </div>
                    <nav aria-label="Điều hướng chính">
                        @if (User.IsInRole(Roles.Family))
                        {
                            <div class="nav-section-title">Cổng Gia Đình</div>
                            <a asp-controller="Family" asp-action="Index"><i class="bi bi-house-heart" aria-hidden="true"></i> Trang chủ Gia đình</a>
                            <a asp-controller="Home" asp-action="Welcome"><i class="bi bi-stars" aria-hidden="true"></i> Giới thiệu & Dịch vụ</a>
                        }
                        else
                        {
                            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Receptionist))
                            {
                                <div class="nav-section-title">Điều hành & Lưu trú</div>
                                <a asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> Tổng quan hệ thống</a>
                                <a asp-controller="Residents" asp-action="Index"><i class="bi bi-person-vcard-fill" aria-hidden="true"></i> Hồ sơ cư dân</a>
                                <a asp-controller="Rooms" asp-action="Index"><i class="bi bi-door-open-fill" aria-hidden="true"></i> Phòng & giường</a>
                                <div class="nav-section-title">Tài chính & Gói dịch vụ</div>
                                <a asp-controller="Billing" asp-action="Index"><i class="bi bi-receipt-cutoff" aria-hidden="true"></i> Hóa đơn & công nợ</a>
                                <a asp-controller="Billing" asp-action="Packages"><i class="bi bi-gem" aria-hidden="true"></i> Gói dịch vụ</a>
                                <a asp-controller="Billing" asp-action="Subscriptions"><i class="bi bi-card-checklist" aria-hidden="true"></i> Đăng ký gói</a>
                            }
                            @if (User.IsInRole(Roles.Caregiver))
                            {
                                <div class="nav-section-title">Không gian Điều dưỡng</div>
                                <a asp-controller="Caregiver" asp-action="Index"><i class="bi bi-speedometer2" aria-hidden="true"></i> Trang chủ Ca trực</a>
                                <a asp-controller="Residents" asp-action="Index"><i class="bi bi-person-vcard-fill" aria-hidden="true"></i> Hồ sơ cư dân</a>
                            }
                            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Caregiver))
                            {
                                <div class="nav-section-title">Y tế & Chăm sóc</div>
                                <a asp-controller="CareTasks" asp-action="Index"><i class="bi bi-clipboard2-check-fill" aria-hidden="true"></i> Công việc chăm sóc</a>
                                <a asp-controller="Medication" asp-action="Today"><i class="bi bi-capsule-pill" aria-hidden="true"></i> Thuốc hôm nay</a>
                                <a asp-controller="Medication" asp-action="Index"><i class="bi bi-calendar2-check-fill" aria-hidden="true"></i> Lịch dùng thuốc</a>
                            }
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <div class="nav-section-title">Quản trị Hệ thống</div>
                                <a asp-controller="Users" asp-action="Index"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i> Tài khoản & phân quyền</a>
                            }
                            <div class="nav-section-title">Cổng thông tin</div>
                            <a asp-controller="Home" asp-action="Welcome"><i class="bi bi-globe2" aria-hidden="true"></i> Trang chủ người dùng</a>
                        }
                        <a asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key-fill" aria-hidden="true"></i> Đổi mật khẩu</a>
                    </nav>
                    <div class="sidebar-note">
                        <strong><i class="bi bi-shield-check me-1"></i> Chuẩn mực An Tâm</strong>
                        Chăm sóc tận tâm · Y khoa minh bạch · Kết nối gia đình 24/7.
                    </div>
                </aside>
            }
            <div class="main-panel">
                <header class="topbar">
                    <div class="topbar-brand-group">
                        @if (User.Identity?.IsAuthenticated != true)
                        {
                            <a class="d-flex align-items-center gap-2 text-decoration-none fw-bold text-dark" asp-controller="Home" asp-action="Welcome">
                                <span class="brand-mark" style="width:36px;height:36px;font-size:1.05rem;"><i class="bi bi-heart-pulse-fill"></i></span>
                                <div>
                                    <span class="d-block lh-1" style="color: var(--navy-deep); font-weight: 800;">An Tâm Residence</span>
                                    <small class="text-secondary" style="font-size: 0.72rem; letter-spacing: 0.08em;">VIỆN DƯỠNG LÃO & CHĂM SÓC Y KHOA CAO CẤP</small>
                                </div>
                            </a>
                        }
                        else
                        {
                            <span class="topbar-badge"><i class="bi bi-stars"></i> @roleTitle</span>
                            <span class="text-secondary d-none d-md-inline">Hệ thống Quản lý & Chăm sóc Viện dưỡng lão An Tâm</span>
                        }
                    </div>
                    <div class="account-area">
                        <a asp-controller="Home" asp-action="Welcome" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-house-heart me-1"></i> Trang chủ người dùng
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="user-pill">
                                <span class="user-avatar-sm">@userInitial</span>
                                <span>@User.Identity.Name</span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button class="btn btn-outline-primary btn-sm" type="submit">
                                    <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập hệ thống
                            </a>
                        }
                    </div>
                </header>
                <main class="container-fluid p-4 p-lg-5">
                    @if (TempData["Success"] is string message)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 shadow-sm border-0 rounded-3 mb-4" role="status">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@message</div>
                        </div>
                    }
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    <div>
                        <strong>An Tâm Luxury Nursing Home</strong> · Hệ thống Quản lý Lưu trú, Chăm sóc & Theo dõi Y tế
                    </div>
                    <div>Dự án học tập · Dữ liệu demo giả lập · Không thay thế quyết định chuyên môn y tế</div>
                </footer>
            </div>
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
