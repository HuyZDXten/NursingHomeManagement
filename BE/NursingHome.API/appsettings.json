{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=NursingHomeDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "_comment": "Key (>= 32 byte) đặt trong appsettings.Development.json hoặc user-secrets, KHÔNG commit.",
    "Key": "",
    "Issuer": "NursingHomeManagement",
    "Audience": "NursingHomeManagementClient",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Cloudinary": {
    "_comment": "Sprint 3: upload ảnh cư dân/giấy tờ. Bỏ trống thì lưu local.",
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Email": {
    "_comment": "OTP quên mật khẩu. Gmail: bật xác minh 2 bước, tạo App Password. Chưa cấu hình thì forgot-password trả 503.",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpSecurity": "StartTls",
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromName": "Nursing Home Management",
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Google": {
    "_comment": "Sprint 3 (UC-02): đăng nhập Google.",
    "ClientId": ""
  },
  "RateLimit": {
    "_comment": "Số lần/phút/IP cho login, quên mật khẩu, đổi mật khẩu. AiMessagesPerMinute dùng ở Sprint 4.",
    "CredentialsPerMinute": 10,
    "AiMessagesPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Facility": {
    "Name": "Viện Dưỡng Lão An Khang",
    "Address": "123 Đường Hoa Sữa, Quận Hải Châu, Đà Nẵng",
    "Hotline": "0236 000 0000",
    "VisitingHours": "08:00-11:00, 14:00-20:00",
    "VitalAlerts": {
      "SystolicHigh": 160,
      "SystolicLow": 90,
      "HeartRateHigh": 120,
      "HeartRateLow": 50,
      "TemperatureHigh": 38.0,
      "SpO2Low": 92
    }
  },
  "PayOs": {
    "_comment": "Một kênh payOS của cơ sở. ClientId/ApiKey/ChecksumKey đặt ở Development/user-secrets. Local: ApiBaseUrl http://localhost:5199 = scripts/payos-fake (không tiền thật).",
    "Enabled": false,
    "ApiBaseUrl": "https://api-merchant.payos.vn",
    "ClientId": "",
    "ApiKey": "",
    "ChecksumKey": "",
    "ReturnUrl": "http://localhost:5173/family/payments/result",
    "CancelUrl": "http://localhost:5173/family/payments/result",
    "LinkLifetimeMinutes": 30,
    "SyncIntervalSeconds": 60
  },
  "Ai": {
    "_comment": "Sprint 4 (AI-01..AI-12): chatbot dùng Gemini như StreetBiz. Key đặt ở user-secrets.",
    "Enabled": false,
    "Provider": "Gemini",
    "Gemini": { "ApiKey": "", "Model": "" },
    "Fallback": { "BaseUrl": "", "ApiKey": "", "Model": "" },
    "MaxOutputTokens": 1024,
    "Temperature": 0.3,
    "PublicChatbotEnabled": true
  }
}
